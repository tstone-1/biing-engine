# User diagnostics must not redirect this test's writes or supply a different scripted sequence.
set(clean --unset=BIING_SEED --unset=BIING_SCREEN --unset=BIING_FIXES --unset=BIING_RNG_SCRIPT
    --unset=BIING_RNG_TRACE --unset=BIING_RNG_LOG --unset=BIING_SIM_CALLS --unset=BIING_SIM_CALL_SAVES)
execute_process(COMMAND "${DRIVER}" fixture "${FIXTURE}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Synthetic fixture creation failed: ${result}")
endif()
foreach(mode sim call)
    foreach(setting unset 1 0 01 1x true)
        if(setting STREQUAL "unset")
            set(env --unset=BIING_SIM_FAST_FORWARD)
        else()
            set(env "BIING_SIM_FAST_FORWARD=${setting}")
        endif()
        set(output "${FIXTURE}/${mode}-${setting}.sav")
        if(mode STREQUAL "sim")
            set(args sim "${FIXTURE}" 0:01 "${FIXTURE}/input.sav" "${output}")
        else()
            set(args call "${FIXTURE}" "${FIXTURE}/input.sav" 27495 1 "${output}")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${clean} ${env} "${DRIVER}" ${args}
            RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${mode}/${setting} failed: ${result}\n${stdout}\n${stderr}")
        endif()
        string(FIND "${stderr}" "simulation mode: fast-forward\n" marker)
        if(setting STREQUAL "1")
            set(expected 0)
            if(marker LESS 0)
                message(FATAL_ERROR "${mode}/${setting}: missing fast-forward acknowledgement")
            endif()
        else()
            set(expected 3)
            if(NOT marker LESS 0)
                message(FATAL_ERROR "${mode}/${setting}: unexpected fast-forward acknowledgement")
            endif()
        endif()
        execute_process(COMMAND "${DRIVER}" check "${output}" "${expected}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${mode}/${setting}: scheduled advice side effect disagrees")
        endif()
    endforeach()
endforeach()
file(REMOVE_RECURSE "${FIXTURE}")
message(STATUS "[PASS] save-driver fast-forward mode: 12 executable cases")
