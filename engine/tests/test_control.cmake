# Real persistent entry point, synthetic game opening/frame callbacks only.
file(MAKE_DIRECTORY "${FIXTURE}")
unset(ENV{BIING_RNG_SCRIPT})
unset(ENV{BIING_RNG_TRACE})
unset(ENV{BIING_FIXES})
unset(ENV{BIING_MIDI_LOG})
set(ENV{SDL_VIDEODRIVER} dummy)
set(ENV{SDL_RENDER_DRIVER} software)
function(run_session name commands)
    file(WRITE "${FIXTURE}/${name}.input" "${commands}")
    execute_process(COMMAND "${DRIVER}" synthetic --control ${ARGN}
        INPUT_FILE "${FIXTURE}/${name}.input" OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE rc TIMEOUT 10)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${name}: ${rc}\n${output}\n${error}")
    endif()
    string(STRIP "${output}" output)
    string(REPLACE ";" "\\;" output "${output}")
    string(REPLACE "\n" ";" rows "${output}")
    set(rows "${rows}" PARENT_SCOPE)
endfunction()
function(field row key expected)
    list(GET rows ${row} json)
    string(JSON got GET "${json}" ${key})
    if(NOT "${got}" STREQUAL "${expected}")
        message(FATAL_ERROR "row ${row} ${key}: ${got}, expected ${expected}: ${json}")
    endif()
endfunction()
function(count expected)
    list(LENGTH rows got)
    if(NOT got EQUAL expected)
        message(FATAL_ERROR "expected ${expected} JSON lines, got ${got}: ${rows}")
    endif()
    math(EXPR last "${got}-1")
    foreach(i RANGE 0 ${last})
        field(${i} seq ${i})
    endforeach()
endfunction()

run_session(persist "status\nwait:2\nwait:2junk\nclick:10,20\ncode:0,48\nsave:${FIXTURE}/control.sav\nshot:${FIXTURE}/control.ppm\nquit\nwait:10\n")
count(9)
field(0 event ready)
field(0 protocol 1)
field(0 window OFF)
field(0 frames 1)
field(1 frames 1)
field(2 frames 3)
field(3 ok OFF)
field(3 frames 3)
field(4 frames 6)
field(5 frames 8)
field(8 quit ON)
field(8 frames 8)
execute_process(COMMAND "${DRIVER}" synthetic --shot "${FIXTURE}/batch.ppm" wait:2 click:10,20 code:0,48
    "save:${FIXTURE}/batch.sav" RESULT_VARIABLE rc ERROR_VARIABLE error)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "batch comparison failed: ${rc} ${error}")
endif()
foreach(ext sav ppm)
    file(SHA256 "${FIXTURE}/control.${ext}" actual)
    file(SHA256 "${FIXTURE}/batch.${ext}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "persistent/batch ${ext} differs")
    endif()
endforeach()

string(REPEAT x 4097 oversized)
run_session(errors "${oversized}\ncode:1,\nmove:1,2x\nwait:30001\nkey:\nload:${FIXTURE}/absent/save\nsave:${FIXTURE}/absent/save\nraw:x\nhold:1\ncash:2\ncall:123\n\nstatus")
count(14)
foreach(i RANGE 1 12)
    field(${i} ok OFF)
    field(${i} frames 1)
endforeach()
field(13 ok ON)
field(13 frames 1)
field(13 quit OFF)
run_session(empty "")
count(1)
run_session(eof "wait:2")
count(2)
field(1 frames 3)
run_session(reload "save:${FIXTURE}/before.sav\nwait:3\nload:${FIXTURE}/before.sav\nsave:${FIXTURE}/after.sav\nstatus\n")
count(6)
field(5 frames 4)
file(SHA256 "${FIXTURE}/before.sav" before)
file(SHA256 "${FIXTURE}/after.sav" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "load did not restore the complete saved world")
endif()
run_session(window "status\nwait:0\n" --window)
count(3)
field(0 window ON)
field(2 frames 1)

# The writer keeps stdin open while a synthetic SDL timer posts a close event.
# The fixture's close callback asserts quit was set and idle advanced only once.
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1
    COMMAND "${CMAKE_COMMAND}" -E env BIING_TEST_CONTROL_CLOSE=idle "${DRIVER}" synthetic --control --window
    RESULTS_VARIABLE results OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT results STREQUAL "0;0")
    message(FATAL_ERROR "idle window close failed: ${results} ${output} ${error}")
endif()
file(WRITE "${FIXTURE}/close.input" "wait:30000\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env BIING_TEST_CONTROL_CLOSE=busy "${DRIVER}" synthetic --control --window
    INPUT_FILE "${FIXTURE}/close.input" RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "busy window close failed: ${rc} ${output} ${error}")
endif()
string(STRIP "${output}" output)
string(REPLACE "\n" ";" rows "${output}")
count(2)
field(1 quit ON)
message(STATUS "control protocol, persistence, rejection, EOF and window close passed")
