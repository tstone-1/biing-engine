# Each run gets a fresh process: fatal diagnostic failures must not continue to later output steps.
set(clean --unset=BIING_RNG_SCRIPT --unset=BIING_RNG_TRACE --unset=BIING_FIXES --unset=BIING_MIDI_LOG)
file(MAKE_DIRECTORY "${FIXTURE}")
file(WRITE "${FIXTURE}/draws" "# raw hexadecimal results\n  \nF\n5\n6\n7\n8")
file(WRITE "${FIXTURE}/readonly-trace" "read only\n")

function(run_case name expected)
    file(REMOVE "${FIXTURE}/${name}.ppm" "${FIXTURE}/${name}.sav")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${clean} ${env}
        "${DRIVER}" synthetic --shot "${FIXTURE}/${name}.ppm" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result EQUAL expected)
        message(FATAL_ERROR "${name}: exit ${result}, expected ${expected}\n${stdout}\n${stderr}")
    endif()
    if(NOT expected EQUAL 0 AND (EXISTS "${FIXTURE}/${name}.ppm" OR EXISTS "${FIXTURE}/${name}.sav"))
        message(FATAL_ERROR "${name}: invalid run wrote its final output")
    endif()
    set(stderr "${stderr}" PARENT_SCOPE)
endfunction()

set(env "BIING_RNG_SCRIPT=${FIXTURE}/draws" "BIING_RNG_TRACE=${FIXTURE}/trace")
run_case(persist 0 "save:${FIXTURE}/first.sav" wait:1 "save:${FIXTURE}/second.sav"
    "load:${FIXTURE}/first.sav" wait:1 "save:${FIXTURE}/third.sav"
    "load:${FIXTURE}/first.sav" wait:1 "save:${FIXTURE}/persist.sav")
if(NOT stderr MATCHES "rng script: 5 of 5 values used, 0 steps after it ran out")
    message(FATAL_ERROR "Missing exact consumption count: ${stderr}")
endif()
file(READ "${FIXTURE}/trace" trace)
if(NOT trace STREQUAL "1234 r10 5 2\n1234 r10 6 1\n1234 r10 7 1\n1234 r10 8 1\n")
    message(FATAL_ERROR "Draw trace disagrees: ${trace}")
endif()
set(expected 5)
foreach(name first second third persist)
    execute_process(COMMAND "${DRIVER}" check "${FIXTURE}/${name}.sav" "${expected}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${name}: stream did not survive save/load")
    endif()
    math(EXPR expected "${expected} + 1")
endforeach()
run_case(exhaust 2 wait:4 "save:${FIXTURE}/exhaust.sav")
if(NOT stderr MATCHES "rng script exhausted" OR NOT stderr MATCHES "5 of 5 values used, 0 steps after it ran out")
    message(FATAL_ERROR "Exhaustion was not reported before fallback: ${stderr}")
endif()
set(env "BIING_RNG_SCRIPT=${FIXTURE}/draws")
run_case(no_trace 0 wait:3)
if(NOT stderr MATCHES "rng script: 5 of 5 values used, 0 steps after it ran out")
    message(FATAL_ERROR "Script without a trace did not consume the stream: ${stderr}")
endif()

set(env)
run_case(natural 0 wait:3 "save:${FIXTURE}/natural.sav")
if(stderr MATCHES "rng script")
    message(FATAL_ERROR "Unscripted run changed diagnostic output: ${stderr}")
endif()
set(env "BIING_RNG_TRACE=${FIXTURE}/trace")
run_case(trace_only 2)

foreach(content "garbage" "100000000" "-1" "+2" "1 junk" "1 2" "0x" "FFFFFFFFFFFFFFFFFFFFFFFF")
    file(WRITE "${FIXTURE}/invalid" "${content}\n")
    set(env "BIING_RNG_SCRIPT=${FIXTURE}/invalid")
    run_case(invalid 2 "save:${FIXTURE}/invalid.sav")
    if(NOT stderr MATCHES "cannot read rng script")
        message(FATAL_ERROR "Bad input was not rejected: ${content}: ${stderr}")
    endif()
endforeach()
file(WRITE "${FIXTURE}/empty" "# no values\n")
set(env "BIING_RNG_SCRIPT=${FIXTURE}/empty")
run_case(empty 2 "save:${FIXTURE}/empty.sav")
if(NOT stderr MATCHES "0 of 0 values used, 0 steps after it ran out")
    message(FATAL_ERROR "Empty input was not exhausted at the first frame: ${stderr}")
endif()
set(env "BIING_RNG_SCRIPT=${FIXTURE}/missing")
run_case(missing 2)
set(env "BIING_RNG_SCRIPT=${FIXTURE}/draws" "BIING_RNG_TRACE=${FIXTURE}/missing/trace")
run_case(trace_open 2)
set(env "BIING_RNG_SCRIPT=${FIXTURE}/draws" "BIING_RNG_TRACE=${FIXTURE}/readonly-trace")
run_case(trace_write 2 "save:${FIXTURE}/trace_write.sav")
if(NOT stderr MATCHES "cannot write rng trace" OR NOT stderr MATCHES "2 of 5 values used")
    message(FATAL_ERROR "Trace write failure was not caught at the first draw: ${stderr}")
endif()
file(REMOVE_RECURSE "${FIXTURE}")
message(STATUS "[PASS] shot scripted RNG: real entry point, stream persistence, parsing, exhaustion and trace errors")
